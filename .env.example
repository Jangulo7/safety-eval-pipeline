# Copy to .env (gitignored) and fill in.

# --- Required: model access via OpenRouter ---
OPENROUTER_API_KEY=

# --- Required for XSTest only ---
# walledai/XSTest is a GATED HuggingFace dataset. Request access at
#   https://huggingface.co/datasets/walledai/XSTest
# then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Inspect ---
INSPECT_LOG_DIR=./logs

# --- Optional: AWS S3 artifact store (the model watcher) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_MODEL_BUCKET=

# --- Optional: alerting ---
ALERT_WEBHOOK_URL=
