.PHONY: help install format lint static test test-cov profile clean all

# Default target
help:
	@echo "LLM Nightly Evaluation Pipeline - Make Targets"
	@echo "=============================================="
	@echo ""
	@echo "Development:"
	@echo "  make install     - Install dependencies"
	@echo "  make format      - Format code with black and isort"
	@echo "  make lint        - Run flake8 linter"
	@echo "  make static      - Run mypy type checking"
	@echo "  make test        - Run pytest test suite"
	@echo "  make test-cov    - Run tests with coverage report"
	@echo "  make profile     - Run cProfile performance analysis"
	@echo "  make all         - Run format, lint, static, and test"
	@echo ""
	@echo "Maintenance:"
	@echo "  make clean       - Remove generated files"
	@echo ""

# Install dependencies
install:
	pip install --break-system-packages -r requirements.txt
	pip install --break-system-packages -r requirements-dev.txt

# Auto-format code with black and isort
format:
	@echo "=== Running black ==="
	black src/ tests/ --line-length 100
	@echo ""
	@echo "=== Running isort ==="
	isort src/ tests/ --profile black --line-length 100
	@echo ""
	@echo "Formatting complete!"

# Run flake8 linter
lint:
	@echo "=== Running flake8 ==="
	flake8 src/ tests/ --max-line-length=100 --extend-ignore=E203,W503
	@echo ""
	@echo "Linting complete!"

# Run mypy static type checking
static:
	@echo "=== Running mypy ==="
	mypy src/ --ignore-missing-imports --no-strict-optional --check-untyped-defs
	@echo ""
	@echo "Type checking complete!"

# Run pytest
test:
	@echo "=== Running pytest ==="
	pytest tests/ -v --tb=short
	@echo ""
	@echo "Tests complete!"

# Run tests with coverage
test-cov:
	@echo "=== Running pytest with coverage ==="
	pytest tests/ -v --cov=src --cov-report=html --cov-report=term
	@echo ""
	@echo "Coverage report generated in htmlcov/index.html"
	@echo ""
	@echo "Tests with coverage complete!"

# Run cProfile performance analysis
profile:
	@echo "=== Running cProfile on scheduler ==="
	python -m cProfile -o profile_scheduler.prof -s cumulative src/scheduler.py || true
	@echo ""
	@echo "=== Profile Statistics ==="
	python -c "import pstats; p = pstats.Stats('profile_scheduler.prof'); p.sort_stats('cumulative').print_stats(20)" || echo "Profile analysis requires a full run"
	@echo ""
	@echo "Full profile saved to profile_scheduler.prof"
	@echo ""
	@echo "Profiling complete!"

# Run all quality checks
all: format lint static test
	@echo ""
	@echo "All quality checks passed!"

# Clean generated files
clean:
	@echo "Cleaning generated files..."
	rm -rf __pycache__ .pytest_cache .mypy_cache htmlcov .coverage
	rm -rf src/__pycache__ src/*/__pycache__ tests/__pycache__
	rm -rf *.prof
	find . -type d -name "*.egg-info" -exec rm -rf {} + 2>/dev/null || true
	find . -type f -name "*.pyc" -delete
	@echo "Cleanup complete!"
