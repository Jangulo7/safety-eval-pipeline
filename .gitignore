# Virtual environments
.venv/
.venv*/
venv/
env/
ENV/

# Environment variables. .env.example is the committed template and must survive
# the wildcards above it, so the negation comes last.
.env
.env.*
*.env
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Private working notes. Any directory whose name starts with a dot and contains
# "private", plus a couple of common variants -- a working folder should not become
# repository content because it was renamed.
#
# NOTE: .gitignore does not apply to files git already tracks. `git mv` a tracked file
# into an ignored directory and it stays tracked. Check with `git ls-files` after moving.
.private/
.private*/
*-private/
private/

# Inspect logs are not committed at all.
#
# StrongREJECT transcripts contain model responses to forbidden prompts and are NEVER
# publishable (docs/SPEC.md §9). The benign tasks' transcripts would be publishable, but
# they are large binary .eval files and everything a reader needs — aggregate scores, per
# stratum scores, sample counts, dataset fingerprints, the full provenance record — is in
# results/published/. Excluding the whole tree removes the chance of a withheld transcript
# reaching a commit through a path nobody thought about.
logs/

# Run outputs (regenerable from results.json); committed results live in results/published/
results/*/
!results/published/
